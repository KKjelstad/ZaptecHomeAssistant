# Install as /etc/zaptec-bridge.env, owned by root, chmod 600.
# Referenced by zaptec-bridge.service via EnvironmentFile=.
#
# The Zaptec ACCOUNT password (used for the first OAuth login; after that the
# bridge refreshes its token automatically). MQTT credentials are NOT here --
# they live in config.yaml (also keep that 0600).
ZAPTEC_PASSWORD=CHANGE_ME
